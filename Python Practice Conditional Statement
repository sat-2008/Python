        "if(cal == \"+\"):\n",
        "  sum = num1 + num2\n",
        "  print(sum)\n",
        "elif(cal == \"-\"):\n",
        "  subtraction = num1 - num2\n",
        "  print(subtraction)\n",
        "elif(cal == \"*\"):\n",
        "  multiplication = num1 * num2\n",
        "  print(multiplication)\n",
        "elif(cal == \"/\"):\n",
        "  division = num1 / num2\n",
        "  print(division)\n",
        "else:\n",
        "  print(\"Enter the correct symbol\")"
